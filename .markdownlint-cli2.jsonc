{
  // Regras completas: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    // Conteúdo didático em prosa não quebra linha em 80 colunas.
    "MD013": false,
    // "Implementação", "Principais hiperparâmetros" etc. se repetem
    // entre seções diferentes (ex: Regressão Linear vs. Logística).
    // Só é erro se o título duplicado estiver sob o mesmo pai.
    "MD024": { "siblings_only": true },
    // <details>/<summary> para FAQs recolhíveis; <strong> dentro do
    // <summary> porque markdown não formata dentro de tags HTML.
    // <img> continua proibido (ver AGENTS.md: usar sintaxe Markdown).
    "MD033": { "allowed_elements": ["details", "summary", "strong"] }
  },
  "globs": ["notes/**/*.md", "README.md", "AGENTS.md"]
}
